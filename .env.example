# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where the site lives (used for the Google login redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The one Google Group every tester joins and every developer adds to their closed test
NEXT_PUBLIC_TESTER_GROUP_EMAIL=testloop-testers@googlegroups.com
